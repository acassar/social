# Variables pour docker-compose.prod.yml (M7-T1) — cp .env.example .env,
# remplir, ne jamais commiter le .env résultant.

# Postgres (conteneur `postgres` du compose de prod)
POSTGRES_USER=social
POSTGRES_PASSWORD=change-me
POSTGRES_DB=social

# Port publié sur l'hôte pour le conteneur api (le reverse proxy du VPS
# pointera dessus — voir doc/BACKLOG.md M7-T2)
API_PORT=3000

# JWT — à générer aléatoirement en prod, jamais les valeurs de dev
# (voir apps/api/.env.example)
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me
JWT_REFRESH_EXPIRES_IN=30d

# CORS — URL publique du front, séparées par des virgules
CORS_ORIGINS=https://social.example.com

# Web Push (M6-T2), optionnel — voir apps/api/.env.example
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
