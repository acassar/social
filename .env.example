# Variables pour docker-compose.prod.yml (M7-T1/M7-T2) — cp .env.example
# .env, remplir, ne jamais commiter le .env résultant.

# Postgres (conteneur `postgres` du compose de prod)
POSTGRES_USER=social
POSTGRES_PASSWORD=change-me
POSTGRES_DB=social

# Ports publiés sur l'hôte pour les conteneurs api / web (le reverse proxy
# du VPS pointe dessus — voir doc/DEPLOY.md)
API_PORT=3000
WEB_PORT=8080

# Dossier hôte en bind mount pour les uploads (mèmes, miniatures) — le
# reverse proxy sert ce même chemin directement sous /uploads (voir
# doc/DEPLOY.md et apps/api/.env.example). Chemin absolu recommandé en prod
# (ex. /srv/social/uploads) ; le défaut ci-dessous est relatif au dossier
# où tourne `docker compose`.
UPLOADS_HOST_DIR=./data/uploads

# JWT — à générer aléatoirement en prod, jamais les valeurs de dev
# (voir apps/api/.env.example)
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me
JWT_REFRESH_EXPIRES_IN=30d

# CORS — URL publique du front, séparées par des virgules
CORS_ORIGINS=https://social.example.com

# URL publique de l'API (M7-T2, sous-domaine dédié — voir doc/DEPLOY.md),
# figée dans le bundle statique du front au build de l'image `web`
# (Vite ne lit pas l'env à l'exécution du conteneur, cf. apps/web/Dockerfile)
VITE_API_URL=https://api.social.example.com

# Web Push (M6-T2), optionnel — voir apps/api/.env.example. VAPID_PUBLIC_KEY
# est aussi passée en build-arg à l'image `web` (bouton d'opt-in masqué côté
# front si vide).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
