// Prisma schema — M0-T4 (users, groups, memberships, invites) + M2-T1 (channels)
// + M3-T1 (posts, text_messages) + M3-T2 (reactions) + M4-T1 (word_entries)
// + M5-T1 (attachments) + M6-T2 (push_subscriptions, channel_notification_preferences).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  owner
  member
}

enum Lang {
  fr
  de
}

enum ChannelType {
  text
  word_of_day
  memes
}

model User {
  id           String   @id @default(uuid())
  displayName  String   @unique @map("display_name")
  nativeLang   Lang     @map("native_lang")
  passwordHash String   @map("password_hash")
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at")

  memberships              Membership[]
  createdInvites           Invite[]                        @relation("InviteCreatedBy")
  usedInvites              Invite[]                        @relation("InviteUsedBy")
  posts                    Post[]
  reactions                Reaction[]
  pushSubscriptions        PushSubscription[]
  channelNotificationPrefs ChannelNotificationPreference[]

  @@map("users")
}

model Group {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  memberships Membership[]
  invites     Invite[]
  channels    Channel[]

  @@map("groups")
}

model Membership {
  id      String @id @default(uuid())
  groupId String @map("group_id")
  userId  String @map("user_id")
  role    Role

  group Group @relation(fields: [groupId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@map("memberships")
}

model Invite {
  id          String    @id @default(uuid())
  groupId     String    @map("group_id")
  code        String    @unique
  createdById String    @map("created_by")
  expiresAt   DateTime? @map("expires_at")
  usedById    String?   @map("used_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  group     Group @relation(fields: [groupId], references: [id])
  createdBy User  @relation("InviteCreatedBy", fields: [createdById], references: [id])
  usedBy    User? @relation("InviteUsedBy", fields: [usedById], references: [id])

  @@map("invites")
}

model Channel {
  id        String      @id @default(uuid())
  groupId   String      @map("group_id")
  name      String
  type      ChannelType
  position  Int
  createdAt DateTime    @default(now()) @map("created_at")

  group                   Group                           @relation(fields: [groupId], references: [id])
  posts                   Post[]
  notificationPreferences ChannelNotificationPreference[]

  @@map("channels")
}

model Post {
  id        String      @id @default(uuid())
  channelId String      @map("channel_id")
  authorId  String      @map("author_id")
  type      ChannelType
  createdAt DateTime    @default(now()) @map("created_at")
  editedAt  DateTime?   @map("edited_at")
  deletedAt DateTime?   @map("deleted_at")

  channel     Channel      @relation(fields: [channelId], references: [id])
  author      User         @relation(fields: [authorId], references: [id])
  textMessage TextMessage?
  wordEntry   WordEntry?
  reactions   Reaction[]
  attachments Attachment[]

  @@index([channelId, createdAt])
  @@map("posts")
}

model TextMessage {
  postId String @id @map("post_id")
  body   String

  post Post @relation(fields: [postId], references: [id])

  @@map("text_messages")
}

model WordEntry {
  postId      String  @id @map("post_id")
  term        String
  lang        Lang
  translation String
  note        String?

  post Post @relation(fields: [postId], references: [id])

  @@map("word_entries")
}

model Reaction {
  id     String @id @default(uuid())
  postId String @map("post_id")
  userId String @map("user_id")
  emoji  String

  post Post @relation(fields: [postId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([postId, userId, emoji])
  @@map("reactions")
}

// M5-T1 : table de stockage créée par avance ; non écrite tant que M5-T2
// (post de type `memes`) ne relie pas un fichier uploadé à un post.
model Attachment {
  id       String  @id @default(uuid())
  postId   String  @map("post_id")
  url      String
  thumbUrl String? @map("thumb_url")
  mime     String
  width    Int?
  height   Int?

  post Post @relation(fields: [postId], references: [id])

  @@map("attachments")
}

// M6-T2 : abonnement Push du navigateur (un par appareil/navigateur ayant
// accepté les notifications), indépendant des salons — un même abonnement
// sert à recevoir les notifs de tous les salons pour lesquels le user a
// activé ChannelNotificationPreference ci-dessous.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("push_subscriptions")
}

// M6-T2 : réglage d'opt-in par salon (désactivé par défaut, jamais de
// forcing — voir doc/SPEC.md §8/§9). La présence d'une ligne vaut opt-in ;
// la supprimer désactive les notifs pour ce salon, sans toucher à
// l'abonnement Push lui-même (potentiellement utilisé par d'autres salons).
model ChannelNotificationPreference {
  id        String   @id @default(uuid())
  channelId String   @map("channel_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  channel Channel @relation(fields: [channelId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([channelId, userId])
  @@map("channel_notification_preferences")
}
