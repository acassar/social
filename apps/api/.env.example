NODE_ENV=development
PORT=3000

# Postgres (voir docker-compose.yml à la racine pour le dev local)
DATABASE_URL="postgresql://social:social@localhost:5432/social?schema=public"

# JWT (M1-T2) — secrets distincts pour l'access token (courte durée) et le
# refresh token (longue durée). À générer aléatoirement en prod, jamais
# les valeurs ci-dessous.
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_REFRESH_EXPIRES_IN=30d

# Uploads (M5-T1) — dossier local où sont écrits les fichiers uploadés
# (mèmes, miniatures). En prod : chemin d'un volume du VPS servi
# statiquement par le reverse proxy sous /uploads.
UPLOADS_DIR=./uploads

# CORS — origines autorisées à appeler l'API depuis un navigateur, séparées
# par des virgules. En dev : le serveur Vite du front. En prod : l'URL
# publique du front.
CORS_ORIGINS=http://localhost:5173

# Web Push (M6-T2) — opt-in par salon, jamais de relance forcée à publier.
# Clés VAPID à générer une fois avec `npx web-push generate-vapid-keys` et à
# garder identiques entre déploiements (sinon les abonnements existants
# deviennent invalides). VAPID_PUBLIC_KEY doit aussi être copiée dans
# apps/web/.env (VITE_VAPID_PUBLIC_KEY). Sans ces clés, l'opt-in par salon
# fonctionne toujours mais aucune notification n'est réellement envoyée.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
