# Vhost du reverse proxy existant du VPS (M7-T2) pour l'API — sous-domaine
# dédié (le front appelle une autre origine, CORS déjà géré côté NestJS,
# voir apps/api/src/main.ts). TLS géré par le mécanisme déjà en place sur ce
# reverse proxy, pas de terminaison TLS ici.
#
# À adapter (domaine, chemins de certs, UPLOADS_HOST_DIR) et déposer aux
# côtés de social-web.conf.example dans la conf du reverse proxy existant.

server {
    listen 443 ssl http2;
    server_name api.social.example.com;

    ssl_certificate     /etc/letsencrypt/live/api.social.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.social.example.com/privkey.pem;

    client_max_body_size 25m; # aligné sur la limite d'upload de mèmes (M5-T1)

    # Fichiers uploadés (mèmes, miniatures) : servis directement depuis le
    # dossier hôte en bind mount (UPLOADS_HOST_DIR de .env, monté dans le
    # conteneur `api` sous /app/apps/api/uploads), sans repasser par Node —
    # remplacer le chemin ci-dessous par la valeur absolue réelle de
    # UPLOADS_HOST_DIR sur le VPS.
    location /uploads/ {
        alias /srv/social/uploads/;
    }

    # Handshake + upgrade WebSocket de la gateway Socket.io (M2-T2/M2-T3) :
    # mêmes en-têtes Upgrade/Connection que le reste de l'API puisque
    # Socket.io négocie sur ce même path avant de basculer en WS. Timeout de
    # lecture augmenté pour ne pas couper les connexions WS ouvertes (défaut
    # nginx 60s trop court pour un socket qui reste idle entre deux events).
    location /socket.io/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
    }

    # Reste de l'API REST (conteneur `api`, publié sur ${API_PORT:-3000}).
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    server_name api.social.example.com;
    return 301 https://$host$request_uri;
}
